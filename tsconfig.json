{
	"compilerOptions": {
		"declaration": true,
		"declarationDir": "dist",
		"rootDir": "src",
		"module": "esnext",
		"target": "es2020",
		"lib": ["es6", "dom", "es2016", "es2017", "es2020"],
		"sourceMap": true,
		"jsx": "react",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"strictNullChecks": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
